{
  "info": {
    "name": "Mini LIMS - Samples API",
    "description": "Manual requests for the sample REST endpoints (steps 6 and 7). Set baseUrl and sampleId in the collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "sampleId", "value": "1" },
    { "key": "technicianId", "value": "1" },
    { "key": "accessToken", "value": "" },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "adminPassword", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Login as configured administrator",
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "if (pm.response.code === 200) {",
            "  pm.collectionVariables.set('accessToken', pm.response.json().accessToken);",
            "}"
          ]
        }
      }],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "List samples",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/samples" }
    },
    {
      "name": "Get sample",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/samples/{{sampleId}}" }
    },
    {
      "name": "Create sample",
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "if (pm.response.code === 201) {",
            "  pm.collectionVariables.set('sampleId', pm.response.json().id);",
            "}"
          ]
        }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sampleCode\": \"S-1001\",\n  \"type\": \"water\",\n  \"description\": \"Manual Postman sample\",\n  \"dateReception\": \"2026-09-25\",\n  \"active\": true\n}"
        },
        "url": "{{baseUrl}}/api/samples"
      }
    },
    {
      "name": "Update sample",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sampleCode\": \"S-1001\",\n  \"type\": \"water\",\n  \"description\": \"Updated sample description\",\n  \"dateReception\": \"2026-09-25\",\n  \"active\": true\n}"
        },
        "url": "{{baseUrl}}/api/samples/{{sampleId}}"
      }
    },
    {
      "name": "Deactivate sample",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/api/samples/{{sampleId}}" }
    },
    {
      "name": "Advance sample status",
      "request": {
        "method": "POST",
        "description": "Call once for PENDING to IN_ANALYSIS, then again for IN_ANALYSIS to COMPLETED.",
        "url": "{{baseUrl}}/api/samples/{{sampleId}}/status/advance"
      }
    },
    {
      "name": "Assign technician to sample",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/samples/{{sampleId}}/technician/{{technicianId}}"
      }
    },
    {
      "name": "Get sample status history",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/samples/{{sampleId}}/status/history"
      }
    }
  ]
}
