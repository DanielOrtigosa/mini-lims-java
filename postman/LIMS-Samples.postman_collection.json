{
  "info": {
    "name": "Mini LIMS - Samples API",
    "description": "Exercise the paginated sample and user APIs, JWT-protected user administration, activation, assignment, and sample status workflow. Configure baseUrl, adminEmail, and adminPassword.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "sampleId",
      "value": "1"
    },
    {
      "key": "technicianId",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": "admin@example.com"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "sampleCode",
      "value": ""
    },
    {
      "key": "sampleVersion",
      "value": "0"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "userEmail",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Login as configured administrator",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('accessToken', pm.response.json().accessToken);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "List users",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/users?page=0&size=20"
      }
    },
    {
      "name": "List samples",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/samples?page=0&size=5"
      }
    },
    {
      "name": "Create sample",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('sampleCode', 'S-' + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set('sampleId', pm.response.json().id);",
              "  pm.collectionVariables.set('sampleVersion', pm.response.json().version);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sampleCode\": \"{{sampleCode}}\",\n  \"type\": \"water\",\n  \"description\": \"Manual Postman sample\",\n  \"dateReception\": \"2026-09-25\",\n  \"active\": true\n}"
        },
        "url": "{{baseUrl}}/api/samples"
      }
    },
    {
      "name": "Get sample",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/samples/{{sampleId}}"
      }
    },
    {
      "name": "Update sample",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sampleCode\": \"{{sampleCode}}\",\n  \"type\": \"water\",\n  \"description\": \"Updated sample description\",\n  \"dateReception\": \"2026-09-25\",\n  \"active\": true,\n  \"version\": {{sampleVersion}}\n}"
        },
        "url": "{{baseUrl}}/api/samples/{{sampleId}}"
      }
    },
    {
      "name": "Deactivate sample",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/samples/{{sampleId}}"
      }
    },
    {
      "name": "Reactivate sample",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"active\": true\n}"
        },
        "url": "{{baseUrl}}/api/samples/{{sampleId}}/activation"
      }
    },
    {
      "name": "Advance sample status",
      "request": {
        "method": "POST",
        "description": "Call once for PENDING to IN_ANALYSIS, then again for IN_ANALYSIS to COMPLETED.",
        "url": "{{baseUrl}}/api/samples/{{sampleId}}/status/advance"
      }
    },
    {
      "name": "Create technician",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('userEmail', 'postman-' + Date.now() + '@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set('technicianId', pm.response.json().id);",
              "  pm.collectionVariables.set('userId', pm.response.json().id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman technician\",\n  \"email\": \"{{userEmail}}\",\n  \"role\": \"TECHNICIAN\",\n  \"department\": \"Lab\",\n  \"location\": \"Bench 1\",\n  \"password\": \"postman-password\"\n}"
        },
        "url": "{{baseUrl}}/api/users"
      }
    },
    {
      "name": "Assign technician to sample",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/samples/{{sampleId}}/technician/{{technicianId}}"
      }
    },
    {
      "name": "Deactivate technician",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"active\": false\n}"
        },
        "url": "{{baseUrl}}/api/users/{{userId}}/activation"
      }
    },
    {
      "name": "Get sample status history",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/samples/{{sampleId}}/status/history"
      }
    }
  ]
}
